{
  "manifest_version": 3,
  "name": "CVMaker",
  "version": "1.2.0",
  "description": "Save job offers to CVMaker, prefill application forms, and keep track of the applications you send. Nothing is ever submitted for you.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "icons": {
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Open CVMaker",
    "default_icon": {
      "128": "icons/logo-128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/index.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the CVMaker panel"
    }
  }
}
