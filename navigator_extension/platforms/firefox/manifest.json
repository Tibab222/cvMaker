{
  "manifest_version": 3,
  "name": "CVMaker",
  "version": "1.2.0",
  "description": "Save job offers to CVMaker, prefill application forms, and keep track of the applications you send. Nothing is ever submitted for you.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cvmaker-navigator@cvmaker",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "128": "icons/logo.png"
  },
  "sidebar_action": {
    "default_title": "CVMaker",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/logo.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the CVMaker panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/index.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background/index.js"
    ]
  }
}
