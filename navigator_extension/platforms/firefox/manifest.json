{
  "manifest_version": 3,
  "name": "CVMaker",
  "version": "1.1.0",
  "description": "Save job offers to CVMaker and prefill application forms from your profile. Nothing is ever submitted for you.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "128": "icons/logo.png"
  },
  "sidebar_action": {
    "default_title": "CVMaker",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/logo.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the CVMaker panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
