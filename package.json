{
  "name": "cv-maker",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "dist-electron/main.dev.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f",
    "start": "npm run rebuild && electron-forge start",
    "package": "npm run rebuild && electron-forge package",
    "clean": "rimraf out",
    "build-all": "npm run clean && npm run build",
    "make": "npm run clean && npm run build && npx electron-rebuild -f -w better-sqlite3,sharp && electron-forge make"
  },
