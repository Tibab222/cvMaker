<cvm version="1">
<meta>
{
  "id": "classic",
  "name": "Classic",
  "description": "The original cvMaker resume: bold uppercase titles, contact links on the right, technology tags on project bullets.",
  "author": "cvMaker",
  "version": "1.0.0",
  "page": { "size": "A4", "margin": "15mm" },
  "vars": { "ink": "#0f172a", "muted": "#64748b", "soft": "#94a3b8", "text": "#334155" }
}
</meta>

<template>
<header class="{{#if photo}}with-photo{{/if}}">
  <div class="identity">
    {{#if photo}}<img class="photo" src="{{photo}}" alt="">{{/if}}
    <div>
      <h1>{{profile.firstName}} <span class="last">{{profile.lastName}}</span></h1>
      {{#if header.title}}<p class="headline">{{header.title}}</p>{{/if}}
    </div>
  </div>
  {{#if contacts}}
  <div class="contacts">
    {{#each contacts}}
      <div class="contact contact-{{key}}"><a href="{{url}}">{{label}}</a>{{icon key 12}}</div>
    {{/each}}
  </div>
  {{/if}}
</header>

{{#if summary}}
<section class="summary">
  <h2 class="small">{{t "resumeSummaryTitle"}}</h2>
  {{editSummary}}
</section>
{{/if}}

{{#if education}}
<section class="education">
  <h2>{{edit "education:section" "title" (t "educationTitle")}}</h2>
  <div class="items">
    {{#each education}}
    <article>
      <div class="row">
        <h3>{{edit this "degree"}}</h3>
        <span class="date">{{period startDate endDate "yyyy" sep=" — "}}</span>
      </div>
      <div class="row sub">
        <span class="institution">{{edit this "institution"}}</span>
        {{#if location}}<span class="location">{{edit this "location"}}</span>{{/if}}
      </div>
      {{#if description}}{{edit this "description" multiline=true class="desc"}}{{/if}}
    </article>
    {{/each}}
  </div>
</section>
{{/if}}

{{#if experiences}}
<section class="experience">
  <h2>{{edit "experience:section" "title" (t "experienceTitle")}}</h2>
  <div class="items">
    {{#each experiences}}
    <article>
      <div class="row">
        <h3>{{edit this "jobTitle"}}<span class="at">@</span>{{edit this "company" class="company"}}</h3>
        <span class="date">{{period startDate endDate "MMM yyyy" sep=" — "}}</span>
      </div>
      {{#if location}}<span class="location">{{location}}</span>{{/if}}
      {{#if description}}{{edit this "description" multiline=true class="desc"}}{{/if}}
    </article>
    {{/each}}
  </div>
</section>
{{/if}}

{{#if projects}}
<section class="projects">
  <h2 class="tight">{{edit "project:section" "title" (t "projectTitle")}}</h2>
  <div class="items">
    {{#each projects}}
    <article>
      <div class="row">
        <h3>
          {{edit this "title"}}
          {{#if showCompany}}<span class="at">@</span>{{edit this "company" company class="company"}}{{/if}}
          {{#if subtitle}}<span class="subtitle">—&nbsp;{{edit this "subtitle"}}</span>{{/if}}
        </h3>
        <span class="meta">
          {{#if link}}<span class="link">{{icon "link" 12}}<a href="{{href link}}">{{shortUrl link}}</a></span>{{/if}}
          {{#if startDate}}<span class="date">{{period startDate endDate "MMM yyyy" sep=" — "}}</span>{{/if}}
        </span>
      </div>
      <ul class="bullets">
        {{#each bullets}}
        <li>{{edit this "text"}}{{#if tags}}<span class="tags">{{#each tags}}<span class="tag">{{this}}</span>{{/each}}</span>{{/if}}</li>
        {{/each}}
      </ul>
    </article>
    {{/each}}
  </div>
</section>
{{/if}}

{{#if skills}}
<section class="skills">
  <h2>{{t "skillsTitle"}}</h2>
  <div class="skill-list">
    {{#each skills}}
    <div class="skill">
      <span class="name">{{name}}</span>
      {{#if proficiency}}<span class="level">({{proficiency}})</span>{{/if}}
      {{#unless @last}}<span class="sep">|</span>{{/unless}}
    </div>
    {{/each}}
  </div>
</section>
{{/if}}
</template>

<style>
:scope {
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-family: "Public Sans Variable", sans-serif;
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}

header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-bottom: 16px; margin-bottom: 8px; border-bottom: 2px solid var(--ink); }
header.with-photo { align-items: center; }
.identity { display: flex; align-items: center; gap: 16px; }
.photo { width: 24mm; height: 24mm; flex-shrink: 0; border-radius: 9999px; object-fit: cover; }
h1 { font-size: 30px; line-height: 36px; font-weight: 900; text-transform: uppercase; letter-spacing: -0.05em; }
h1 .last { color: var(--muted); }
.headline { margin-top: 2px; font-size: 14px; line-height: 20px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.025em; }

.contacts { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px 16px; max-width: 55%; font-size: 10px; color: var(--text); }
.contact { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
.contact a { font-weight: 500; }
.contact .cv-icon { color: var(--soft); }
.contact-mail a, .contact-portfolio a, .contact-link a { text-decoration: underline; text-decoration-color: #cbd5e1; }
.contact-github a { font-family: ui-monospace, monospace; font-size: 9px; font-style: italic; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; }
.contact-github .cv-icon { color: var(--ink); }

h2 { font-size: 14px; line-height: 20px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.2em; color: var(--ink); border-bottom: 2px solid var(--ink); padding-bottom: 4px; }
h2.tight { padding-bottom: 0; }
h2.small { font-size: 12px; font-weight: 600; letter-spacing: 0.025em; color: #1e293b; border: none; padding: 0; }
section { display: flex; flex-direction: column; gap: 12px; }
.items { display: flex; flex-direction: column; gap: 16px; }
article { display: flex; flex-direction: column; break-inside: avoid; }
.row { display: flex; justify-content: space-between; align-items: baseline; }
h3 { font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--ink); line-height: 1; }
.at, .company { color: var(--soft); font-weight: 400; }
.date { font-size: 10px; font-weight: 700; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; text-transform: uppercase; margin-left: 16px; }
.desc { font-size: 11px; color: var(--text); white-space: pre-line; text-align: justify; }

.summary { gap: 6px; }
.summary .cv-bullets { list-style: disc outside; margin-left: 16px; display: flex; flex-direction: column; gap: 4px; font-size: 11px; color: var(--text); line-height: 1.375; }
.summary li { padding-left: 2px; }

.education .items { gap: 16px; }
.education h3 { font-size: 12px; line-height: 1.4; }
.education .sub { font-size: 11px; }
.education .institution { color: var(--text); font-weight: 500; font-style: italic; }
.education .location { color: var(--muted); font-style: italic; }
.education .desc { margin-top: 4px; color: #475569; line-height: 1.375; }

.experience { gap: 16px; }
.experience .items { gap: 24px; }
.experience .location { margin-top: 4px; font-size: 9px; font-weight: 700; color: var(--soft); text-transform: uppercase; letter-spacing: 0.05em; }
.experience .desc { margin-top: 8px; line-height: 1.625; }

.projects { gap: 8px; }
.projects .items { gap: 12px; }
.projects article { gap: 4px; }
.projects .row { line-height: 1; }
.subtitle { margin-left: 8px; color: var(--soft); font-weight: 400; font-style: italic; text-transform: none; }
.meta { display: flex; flex-shrink: 0; align-items: baseline; gap: 8px; padding-left: 8px; }
.meta .date { margin-left: 0; }
.link { display: inline-flex; align-items: baseline; color: var(--soft); }
.link .cv-icon { padding-right: 4px; }
.link a { font-family: ui-monospace, monospace; font-size: 9px; }
.bullets { margin-top: 6px; display: flex; flex-direction: column; gap: 6px; }
.bullets li { position: relative; padding-left: 16px; font-size: 11px; color: var(--text); line-height: 1.375; text-align: justify; }
.bullets li::before { content: ""; position: absolute; left: 0; top: 6px; width: 4px; height: 4px; border-radius: 9999px; background: var(--soft); }
.tags { display: inline-flex; flex-wrap: wrap; gap: 4px; margin-left: 8px; }
.tag { font-size: 9px; font-weight: 700; color: var(--muted); background: #f1f5f9; padding: 0 4px; border-radius: 2px; text-transform: uppercase; letter-spacing: -0.025em; }

.skills { gap: 8px; }
.skill-list { display: flex; flex-wrap: wrap; gap: 8px 16px; padding: 4px; }
.skill { display: flex; align-items: center; gap: 8px; }
.skill .name { font-size: 11px; font-weight: 700; color: #1e293b; text-transform: uppercase; letter-spacing: -0.025em; }
.skill .level { font-size: 10px; font-weight: 500; color: var(--muted); font-style: italic; }
.skill .sep { margin-left: 8px; color: #cbd5e1; font-weight: 300; }
</style>
</cvm>
